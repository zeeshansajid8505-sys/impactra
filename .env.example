# ==============================================================================
# Impactra Platform — Local Development Environment Configuration
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit .env with real credentials into source control.
# ==============================================================================

# Node Environment & Port
NODE_ENV=development
PORT=3001

# PostgreSQL Configuration
# Local container service: impactra-postgres
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=impactra
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5433/impactra

# Redis Configuration
# Local container service: impactra-redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO S3-Compatible Object Storage Configuration
# Local container service: impactra-minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_USE_SSL=false
MINIO_BUCKET=impactra-artifacts

# Security, CORS & Cookies
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://impactra.local

# Session Cookie Security
# Set to false for local unencrypted HTTP development/testing.
# Defaults to true in production when unset. Set to true in true HTTPS production.
COOKIE_SECURE=false

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001

# GitHub App Integration (Optional in local development)
# Provide to enable live GitHub App installation & repository synchronization
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Repository Ingestion & Digital Twin Limits (Optional overrides)
INGESTION_MAX_ARCHIVE_BYTES=52428800
INGESTION_MAX_EXTRACTED_BYTES=262144000
INGESTION_MAX_FILE_BYTES=5242880
INGESTION_MAX_FILE_COUNT=10000
INGESTION_MAX_PATH_DEPTH=20
INGESTION_MAX_PATH_LENGTH=255

# Change / Pull Request Ingestion & Diff Limits (Optional overrides)
CHANGE_MAX_FILES=1000
CHANGE_MAX_PATCH_BYTES_PER_FILE=262144
CHANGE_MAX_TOTAL_PATCH_BYTES=10485760
CHANGE_ANALYSIS_TIMEOUT_SECONDS=300

# Blast Radius Traversal & Safety Limits (Optional overrides)
BLAST_RADIUS_MAX_DEPTH=5
BLAST_RADIUS_MAX_AFFECTED_NODES=5000
BLAST_RADIUS_MAX_EVIDENCE_PATHS=10000
