# ==============================================================================
# Impactra Platform — Production & Development Environment Configuration
# Copy this file to .env for local deployment: cp .env.example .env
# For production deployment, inject secrets via environment management / secrets vault.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 2. Production URLs & Routing
# ------------------------------------------------------------------------------
# Web application public URL (canonical entrypoint for browser sessions and redirects)
# Development: http://localhost:3000 or http://impactra.local
# Production:  https://impactra.example.com
WEB_URL=https://impactra.example.com

# Backend API public URL (OpenAPI docs, API clients, and webhook targets)
# Development: http://localhost:3001
# Production:  https://api.impactra.example.com (or https://impactra.example.com/api)
API_URL=https://api.impactra.example.com

# Frontend public API target used by the browser client
NEXT_PUBLIC_API_URL=https://api.impactra.example.com

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL 17)
# ------------------------------------------------------------------------------
POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=impactra
POSTGRES_HOST=impactra-postgres
POSTGRES_PORT=5432
# Complete Prisma connection URL:
DATABASE_URL=postgresql://CHANGE_ME_POSTGRES_USER:CHANGE_ME_POSTGRES_PASSWORD@impactra-postgres:5432/impactra?schema=public&sslmode=prefer

# ------------------------------------------------------------------------------
# 4. Redis & BullMQ Background Queue
# ------------------------------------------------------------------------------
# Development: redis://localhost:6379 (or redis://impactra-redis:6379)
# Production:  rediss://:CHANGE_ME_REDIS_PASSWORD@redis.example.com:6379
REDIS_URL=redis://impactra-redis:6379
REDIS_HOST=impactra-redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. Object Storage (S3-Compatible: MinIO, AWS S3, Cloudflare R2, GCP Storage)
# ------------------------------------------------------------------------------
# Standard S3 configuration (preferred for production):
STORAGE_ENDPOINT=impactra-minio
STORAGE_PORT=9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=impactra-artifacts
STORAGE_ACCESS_KEY=CHANGE_ME_STORAGE_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET
STORAGE_USE_SSL=false
STORAGE_FORCE_PATH_STYLE=true

# MinIO fallbacks (supported for local development):
MINIO_ENDPOINT=impactra-minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_STORAGE_KEY
MINIO_SECRET_KEY=CHANGE_ME_STORAGE_SECRET
MINIO_USE_SSL=false
MINIO_BUCKET=impactra-artifacts

# ------------------------------------------------------------------------------
# 6. Security, CORS & Cookies
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for browser CORS and CSRF protection
CORS_ORIGIN=https://impactra.example.com,https://api.impactra.example.com

# Secure cookie flag. Must be true for HTTPS production deployments.
# Set to false only for local unencrypted HTTP development/testing.
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 7. GitHub App Integration (Production Release Gates & Ingestion)
# ------------------------------------------------------------------------------
# GitHub App ID (from GitHub App Settings)
GITHUB_APP_ID=
# GitHub App Slug (app name in GitHub URL)
GITHUB_APP_SLUG=
# Base64-encoded RSA Private Key (.pem file encoded as Base64)
GITHUB_APP_PRIVATE_KEY_BASE64=
# Webhook secret for HMAC-SHA256 signature verification
GITHUB_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
# GitHub API endpoints (override only for GitHub Enterprise Server)
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# ------------------------------------------------------------------------------
# 8. Ingestion & Analysis Safety Limits
# ------------------------------------------------------------------------------
INGESTION_MAX_ARCHIVE_BYTES=52428800
INGESTION_MAX_EXTRACTED_BYTES=262144000
INGESTION_MAX_FILE_BYTES=5242880
INGESTION_MAX_FILE_COUNT=10000
INGESTION_MAX_PATH_DEPTH=20
INGESTION_MAX_PATH_LENGTH=255

CHANGE_MAX_FILES=1000
CHANGE_MAX_PATCH_BYTES_PER_FILE=262144
CHANGE_MAX_TOTAL_PATCH_BYTES=10485760
CHANGE_ANALYSIS_TIMEOUT_SECONDS=300

BLAST_RADIUS_MAX_DEPTH=5
BLAST_RADIUS_MAX_AFFECTED_NODES=5000
BLAST_RADIUS_MAX_EVIDENCE_PATHS=10000

# ------------------------------------------------------------------------------
# 9. Logging & Observability
# ------------------------------------------------------------------------------
# Logging level: debug | info | warn | error
LOG_LEVEL=info
