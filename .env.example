# ==============================================================================
# Impactra Platform — Local Development Environment Configuration
# Copy this file to .env for local development: cp .env.example .env
# DO NOT commit .env with real credentials into source control.
# ==============================================================================

# Node Environment & Port
NODE_ENV=development
PORT=3001

# PostgreSQL Configuration
# Local container service: impactra-postgres
POSTGRES_USER=impactra_app
POSTGRES_PASSWORD=impactra_local_dev_pass
POSTGRES_DB=impactra
DATABASE_URL=postgresql://impactra_app:impactra_local_dev_pass@localhost:5432/impactra?schema=public

# Redis Configuration
# Local container service: impactra-redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO S3-Compatible Object Storage Configuration
# Local container service: impactra-minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=impactra_minio_admin
MINIO_SECRET_KEY=impactra_minio_dev_secret
MINIO_USE_SSL=false
MINIO_BUCKET=impactra-artifacts

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://impactra.local

# Logging Level: debug | info | warn | error
LOG_LEVEL=info

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
