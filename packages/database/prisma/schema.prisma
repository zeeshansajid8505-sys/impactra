datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Foundational SystemMetadata model.
/// Provides schema verification, migrations foundation, and health checks
/// without inventing artificial or premature business domain models.
model SystemMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_metadata")
}

/// Role-Based Access Control (RBAC) roles for Impactra organizations.
enum MembershipRole {
  OWNER
  ADMIN
  ARCHITECT
  SECURITY_ENGINEER
  DEVELOPER
  RELEASE_MANAGER
  QA_ENGINEER
  AUDITOR
  VIEWER
}

/// Core User entity.
model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String
  passwordHash            String                   @map("password_hash")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  memberships             OrganizationMembership[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         OrganizationInvitation[]   @relation("InvitedByUser")
  githubInstallationStates GitHubInstallationState[]
  repositoryIngestions    RepositoryIngestion[]

  @@map("users")
}

/// Organization tenant boundary for multi-tenancy.
model Organization {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  memberships             OrganizationMembership[]
  invitations             OrganizationInvitation[]
  githubInstallations     GitHubInstallation[]
  githubInstallationStates GitHubInstallationState[]
  repositoryConnections   RepositoryConnection[]
  repositoryIngestions    RepositoryIngestion[]
  repositorySnapshots     RepositorySnapshot[]
  digitalTwinSnapshots    DigitalTwinSnapshot[]
  changeSets              ChangeSet[]
  changeRevisions         ChangeRevision[]
  blastRadiusAnalyses     BlastRadiusAnalysis[]
  releaseSafetyAssessments ReleaseSafetyAssessment[]
  releaseSafetySignals    ReleaseSafetySignal[]
  gitHubCheckPublications GitHubCheckPublication[]

  @@map("organizations")
}

/// Organization membership linking users to organizations with assigned roles.
model OrganizationMembership {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(DEVELOPER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Durable, server-managed user sessions.
/// Stores only the cryptographically secure SHA-256 hash of the session token.
model Session {
  id               String    @id @default(uuid())
  sessionTokenHash String    @unique @map("session_token_hash")
  userId           String    @map("user_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Password reset tokens for secure credential recovery.
/// Stores only the SHA-256 hash of the reset token with single-use flag.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Email verification tokens.
/// Stores only the SHA-256 hash of the verification token.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Invitations for joining an organization.
/// Stores hashed invitation token with expiration and role.
model OrganizationInvitation {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  email          String
  role           MembershipRole @default(DEVELOPER)
  tokenHash      String         @unique @map("token_hash")
  inviterId      String         @map("inviter_id")
  expiresAt      DateTime       @map("expires_at")
  acceptedAt     DateTime?      @map("accepted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User           @relation("InvitedByUser", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

/// GitHub Installation Status enum.
enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  DELETED
  DISCONNECTED
}

/// GitHub App installation bound to an Impactra organization.
model GitHubInstallation {
  id                   String                   @id @default(uuid())
  organizationId       String                   @map("organization_id")
  githubInstallationId String                   @unique @map("github_installation_id")
  accountId            String                   @map("account_id")
  accountLogin         String                   @map("account_login")
  accountType          String                   @map("account_type")
  repositorySelection  String                   @map("repository_selection")
  permissions          Json                     @map("permissions")
  events               Json                     @map("events")
  status               GitHubInstallationStatus @default(ACTIVE)
  installedAt          DateTime                 @default(now()) @map("installed_at")
  suspendedAt          DateTime?                @map("suspended_at")
  lastSyncedAt         DateTime?                @map("last_synced_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositories         RepositoryConnection[]

  @@index([organizationId])
  @@index([status])
  @@map("github_installations")
}

/// Ephemeral CSRF installation state binding user and organization.
model GitHubInstallationState {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  stateHash      String       @unique @map("state_hash")
  expiresAt      DateTime     @map("expires_at")
  consumedAt     DateTime?    @map("consumed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@map("github_installation_states")
}

/// Repository connection metadata tracked by Impactra.
model RepositoryConnection {
  id                   String              @id @default(uuid())
  organizationId       String              @map("organization_id")
  githubInstallationId String              @map("github_installation_id")
  githubRepositoryId   String              @map("github_repository_id")
  ownerLogin           String              @map("owner_login")
  name                 String
  fullName             String              @map("full_name")
  defaultBranch        String              @default("main") @map("default_branch")
  isPrivate            Boolean             @default(false) @map("is_private")
  visibility           String              @default("public")
  archived             Boolean             @default(false)
  disabled             Boolean             @default(false)
  fork                 Boolean             @default(false)
  htmlUrl              String?             @map("html_url")
  available            Boolean             @default(true)
  connected            Boolean             @default(false)
  connectedAt          DateTime?           @map("connected_at")
  disconnectedAt       DateTime?           @map("disconnected_at")
  lastSyncedAt         DateTime?           @map("last_synced_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation         GitHubInstallation  @relation(fields: [githubInstallationId], references: [githubInstallationId], onDelete: Cascade)
  ingestions           RepositoryIngestion[]
  snapshots            RepositorySnapshot[]
  digitalTwins         DigitalTwinSnapshot[]
  changeSets           ChangeSet[]
  changeRevisions      ChangeRevision[]
  gitHubCheckPublications GitHubCheckPublication[]

  @@unique([organizationId, githubRepositoryId])
  @@index([organizationId])
  @@index([githubInstallationId])
  @@index([connected])
  @@index([available])
  @@map("repository_connections")
}

/// Idempotent webhook delivery log for GitHub events.
model GitHubWebhookDelivery {
  id                   String    @id @default(uuid())
  githubDeliveryId     String    @unique @map("github_delivery_id")
  event                String
  action               String?
  githubInstallationId String?   @map("github_installation_id")
  organizationId       String?   @map("organization_id")
  payloadSha256        String    @map("payload_sha256")
  status               String    @default("processed")
  receivedAt           DateTime  @default(now()) @map("received_at")
  processedAt          DateTime? @map("processed_at")
  failureCode          String?   @map("failure_code")
  attemptCount         Int       @default(1) @map("attempt_count")

  @@index([event])
  @@index([githubInstallationId])
  @@index([organizationId])
  @@index([receivedAt])
  @@map("github_webhook_deliveries")
}

/// Repository Ingestion Status enum.
enum RepositoryIngestionStatus {
  QUEUED
  FETCHING
  VALIDATING
  INDEXING
  BUILDING_TWIN
  STORING
  SUCCEEDED
  FAILED
}

/// Digital Twin Node Type enum.
enum DigitalTwinNodeType {
  REPOSITORY
  FILE
  WORKSPACE_PACKAGE
  EXTERNAL_DEPENDENCY
  CONFIG
}

/// Digital Twin Edge Type enum.
enum DigitalTwinEdgeType {
  CONTAINS
  IMPORTS
  DECLARES_DEPENDENCY
  WORKSPACE_DEPENDS_ON
}

/// Repository File Category enum.
enum RepositoryFileCategory {
  SOURCE_CODE
  CONFIGURATION
  DOCUMENTATION
  TEST
  BUILD_SYSTEM
  DATA
  BINARY
  OTHER
}

/// Tracked ingestion job for a repository connection.
model RepositoryIngestion {
  id                     String                    @id @default(uuid())
  organizationId         String                    @map("organization_id")
  repositoryConnectionId String                    @map("repository_connection_id")
  requestedByUserId      String?                   @map("requested_by_user_id")
  targetRef              String                    @default("main") @map("target_ref")
  commitSha              String?                   @map("commit_sha")
  status                 RepositoryIngestionStatus @default(QUEUED)
  stage                  String                    @default("QUEUED")
  startedAt              DateTime?                 @map("started_at")
  completedAt            DateTime?                 @map("completed_at")
  failureCode            String?                   @map("failure_code")
  failureMessage         String?                   @map("failure_message")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection      @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  requestedByUser        User?                     @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  snapshots              RepositorySnapshot[]

  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@index([status])
  @@index([createdAt])
  @@map("repository_ingestions")
}

/// Immutable snapshot representing a repository's source code at a specific commit.
model RepositorySnapshot {
  id                     String                    @id @default(uuid())
  organizationId         String                    @map("organization_id")
  repositoryConnectionId String                    @map("repository_connection_id")
  ingestionId            String                    @map("ingestion_id")
  commitSha              String                    @map("commit_sha")
  ref                    String
  sourceProvider         String                    @default("github") @map("source_provider")
  parserVersion          String                    @default("digital-twin-parser-v1") @map("parser_version")
  artifactKey            String?                   @map("artifact_key")
  artifactSha256         String?                   @map("artifact_sha256")
  sourceBytes            Int                       @default(0) @map("source_bytes")
  fileCount              Int                       @default(0) @map("file_count")
  createdAt              DateTime                  @default(now()) @map("created_at")
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection      @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  ingestion              RepositoryIngestion       @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  fileInventories        RepositoryFileInventory[]
  digitalTwins           DigitalTwinSnapshot[]
  baseChangeRevisions    ChangeRevision[]          @relation("BaseSnapshot")
  headChangeRevisions    ChangeRevision[]          @relation("HeadSnapshot")

  @@unique([repositoryConnectionId, commitSha, parserVersion])
  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@index([commitSha])
  @@map("repository_snapshots")
}

/// Detailed file metadata extracted during snapshot indexing.
model RepositoryFileInventory {
  id                   String                 @id @default(uuid())
  repositorySnapshotId String                 @map("repository_snapshot_id")
  path                 String
  contentSha256        String                 @map("content_sha256")
  byteSize             Int                    @map("byte_size")
  language             String?
  isBinary             Boolean                @default(false) @map("is_binary")
  category             RepositoryFileCategory @default(SOURCE_CODE)
  createdAt            DateTime               @default(now()) @map("created_at")
  snapshot             RepositorySnapshot     @relation(fields: [repositorySnapshotId], references: [id], onDelete: Cascade)

  @@unique([repositorySnapshotId, path])
  @@index([repositorySnapshotId])
  @@index([language])
  @@index([category])
  @@map("repository_file_inventories")
}

/// Architectural digital twin graph generated for a repository snapshot.
model DigitalTwinSnapshot {
  id                     String                 @id @default(uuid())
  organizationId         String                 @map("organization_id")
  repositoryConnectionId String                 @map("repository_connection_id")
  repositorySnapshotId   String                 @unique @map("repository_snapshot_id")
  twinVersion            String                 @default("digital-twin-v1") @map("twin_version")
  nodeCount              Int                    @default(0) @map("node_count")
  edgeCount              Int                    @default(0) @map("edge_count")
  createdAt              DateTime               @default(now()) @map("created_at")
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection   @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  repositorySnapshot     RepositorySnapshot     @relation(fields: [repositorySnapshotId], references: [id], onDelete: Cascade)
  nodes                  DigitalTwinNode[]
  edges                  DigitalTwinEdge[]

  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@map("digital_twin_snapshots")
}

/// Graph vertex representing a software entity within the Digital Twin.
model DigitalTwinNode {
  id                    String              @id @default(uuid())
  digitalTwinSnapshotId String              @map("digital_twin_snapshot_id")
  stableKey             String              @map("stable_key")
  type                  DigitalTwinNodeType
  name                  String
  path                  String?
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at")
  snapshot              DigitalTwinSnapshot @relation(fields: [digitalTwinSnapshotId], references: [id], onDelete: Cascade)
  outgoingEdges         DigitalTwinEdge[]   @relation("SourceNode")
  incomingEdges         DigitalTwinEdge[]   @relation("TargetNode")
  twinMappings          TwinChangeMapping[]
  blastRadiusRoots      BlastRadiusRoot[]
  blastRadiusFindings   BlastRadiusFinding[]

  @@unique([digitalTwinSnapshotId, stableKey])
  @@index([digitalTwinSnapshotId])
  @@index([type])
  @@index([stableKey])
  @@map("digital_twin_nodes")
}

/// Graph directed edge representing an architectural dependency or relationship.
model DigitalTwinEdge {
  id                    String              @id @default(uuid())
  digitalTwinSnapshotId String              @map("digital_twin_snapshot_id")
  sourceNodeId          String              @map("source_node_id")
  targetNodeId          String              @map("target_node_id")
  type                  DigitalTwinEdgeType
  evidence              Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at")
  snapshot              DigitalTwinSnapshot @relation(fields: [digitalTwinSnapshotId], references: [id], onDelete: Cascade)
  sourceNode            DigitalTwinNode     @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode            DigitalTwinNode     @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([digitalTwinSnapshotId, sourceNodeId, targetNodeId, type])
  @@index([digitalTwinSnapshotId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([type])
  @@map("digital_twin_edges")
}

/// Change Revision Status enum.
enum ChangeRevisionStatus {
  QUEUED
  FETCHING
  WAITING_FOR_SNAPSHOTS
  ANALYZING
  MAPPING_TWIN
  STORING
  SUCCEEDED
  FAILED
}

/// Changed File Status enum.
enum ChangedFileStatus {
  ADDED
  MODIFIED
  DELETED
  RENAMED
}

/// Twin Mapping Side enum.
enum TwinMappingSide {
  BEFORE
  AFTER
}

/// Twin Mapping Type enum.
enum TwinMappingType {
  EXACT_PATH
  RENAMED_PATH
  NOT_PRESENT
}

/// Dependency Delta Type enum.
enum DependencyDeltaType {
  EDGE_ADDED
  EDGE_REMOVED
}

/// Logical Pull Request / ChangeSet tracked per repository.
model ChangeSet {
  id                     String               @id @default(uuid())
  organizationId         String               @map("organization_id")
  repositoryConnectionId String               @map("repository_connection_id")
  provider               String               @default("github")
  providerPullRequestId  String               @map("provider_pull_request_id")
  pullRequestNumber      Int                  @map("pull_request_number")
  title                  String
  authorLogin            String               @map("author_login")
  baseRef                String               @map("base_ref")
  headRef                String               @map("head_ref")
  currentBaseSha         String               @map("current_base_sha")
  currentHeadSha         String               @map("current_head_sha")
  state                  String               @default("open")
  isDraft                Boolean              @default(false) @map("is_draft")
  isMerged               Boolean              @default(false) @map("is_merged")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  revisions              ChangeRevision[]
  blastRadiusAnalyses    BlastRadiusAnalysis[]
  releaseSafetyAssessments ReleaseSafetyAssessment[]
  gitHubCheckPublications GitHubCheckPublication[]

  @@unique([repositoryConnectionId, pullRequestNumber])
  @@unique([repositoryConnectionId, providerPullRequestId])
  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@index([state])
  @@map("change_sets")
}

/// Immutable analysis revision for an exact baseSha -> headSha commit pair.
model ChangeRevision {
  id                     String               @id @default(uuid())
  changeSetId            String               @map("change_set_id")
  organizationId         String               @map("organization_id")
  repositoryConnectionId String               @map("repository_connection_id")
  baseSha                String               @map("base_sha")
  headSha                String               @map("head_sha")
  baseSnapshotId         String?              @map("base_snapshot_id")
  headSnapshotId         String?              @map("head_snapshot_id")
  analysisVersion        String               @default("change-analysis-v1") @map("analysis_version")
  status                 ChangeRevisionStatus @default(QUEUED)
  stage                  String               @default("QUEUED")
  filesAdded             Int                  @default(0) @map("files_added")
  filesModified          Int                  @default(0) @map("files_modified")
  filesDeleted           Int                  @default(0) @map("files_deleted")
  filesRenamed           Int                  @default(0) @map("files_renamed")
  nodesAdded             Int                  @default(0) @map("nodes_added")
  nodesRemoved           Int                  @default(0) @map("nodes_removed")
  nodesModified          Int                  @default(0) @map("nodes_modified")
  edgesAdded             Int                  @default(0) @map("edges_added")
  edgesRemoved           Int                  @default(0) @map("edges_removed")
  failureCode            String?              @map("failure_code")
  failureMessage         String?              @map("failure_message")
  queuedAt               DateTime             @default(now()) @map("queued_at")
  startedAt              DateTime?            @map("started_at")
  completedAt            DateTime?            @map("completed_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  changeSet              ChangeSet            @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  baseSnapshot           RepositorySnapshot?  @relation("BaseSnapshot", fields: [baseSnapshotId], references: [id], onDelete: SetNull)
  headSnapshot           RepositorySnapshot?  @relation("HeadSnapshot", fields: [headSnapshotId], references: [id], onDelete: SetNull)
  changedFiles           ChangedFile[]
  twinMappings           TwinChangeMapping[]
  dependencyDeltas       DependencyDelta[]
  blastRadiusAnalyses    BlastRadiusAnalysis[]
  releaseSafetyAssessments ReleaseSafetyAssessment[]
  gitHubCheckPublications GitHubCheckPublication[]

  @@unique([changeSetId, baseSha, headSha, analysisVersion])
  @@index([changeSetId])
  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@index([status])
  @@index([baseSha])
  @@index([headSha])
  @@map("change_revisions")
}

/// Metadata and diff stats for a file changed in a pull request revision.
model ChangedFile {
  id               String            @id @default(uuid())
  changeRevisionId String            @map("change_revision_id")
  oldPath          String?           @map("old_path")
  newPath          String?           @map("new_path")
  status           ChangedFileStatus
  additions        Int               @default(0)
  deletions        Int               @default(0)
  changes          Int               @default(0)
  patchAvailable   Boolean           @default(false) @map("patch_available")
  patchTruncated   Boolean           @default(false) @map("patch_truncated")
  binary           Boolean           @default(false)
  createdAt        DateTime          @default(now()) @map("created_at")
  changeRevision   ChangeRevision    @relation(fields: [changeRevisionId], references: [id], onDelete: Cascade)
  twinMappings     TwinChangeMapping[]

  @@index([changeRevisionId])
  @@index([status])
  @@map("changed_files")
}

/// Deterministic mapping between a changed file and Digital Twin nodes/snapshots.
model TwinChangeMapping {
  id                    String              @id @default(uuid())
  changeRevisionId      String              @map("change_revision_id")
  changedFileId         String              @map("changed_file_id")
  side                  TwinMappingSide
  mappingType           TwinMappingType     @map("mapping_type")
  repositorySnapshotId  String?             @map("repository_snapshot_id")
  digitalTwinSnapshotId String?             @map("digital_twin_snapshot_id")
  digitalTwinNodeId     String?             @map("digital_twin_node_id")
  nodeStableKey         String?             @map("node_stable_key")
  path                  String
  createdAt             DateTime            @default(now()) @map("created_at")
  changeRevision        ChangeRevision      @relation(fields: [changeRevisionId], references: [id], onDelete: Cascade)
  changedFile           ChangedFile         @relation(fields: [changedFileId], references: [id], onDelete: Cascade)
  digitalTwinNode       DigitalTwinNode?    @relation(fields: [digitalTwinNodeId], references: [id], onDelete: SetNull)
  blastRadiusRoots      BlastRadiusRoot[]

  @@index([changeRevisionId])
  @@index([changedFileId])
  @@index([digitalTwinNodeId])
  @@index([side])
  @@map("twin_change_mappings")
}

/// Direct graph edge additions and removals between base and head Digital Twins.
model DependencyDelta {
  id               String              @id @default(uuid())
  changeRevisionId String              @map("change_revision_id")
  deltaType        DependencyDeltaType @map("delta_type")
  sourceStableKey  String              @map("source_stable_key")
  targetStableKey  String              @map("target_stable_key")
  edgeType         DigitalTwinEdgeType @map("edge_type")
  beforeEvidence   Json?               @default("{}") @map("before_evidence")
  afterEvidence    Json?               @default("{}") @map("after_evidence")
  createdAt        DateTime            @default(now()) @map("created_at")
  changeRevision   ChangeRevision      @relation(fields: [changeRevisionId], references: [id], onDelete: Cascade)

  @@index([changeRevisionId])
  @@index([deltaType])
  @@index([sourceStableKey])
  @@index([targetStableKey])
  @@map("dependency_deltas")
}

/// Blast Radius Analysis Status enum.
enum BlastRadiusAnalysisStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Blast Radius Snapshot Side enum.
enum BlastRadiusSnapshotSide {
  BASE
  HEAD
}

/// Blast Radius Impact Class enum.
enum BlastRadiusImpactClass {
  FIRST_ORDER
  TRANSITIVE
}

/// Blast Radius Category enum derived deterministically from Digital Twin node types.
enum BlastRadiusCategory {
  REPOSITORY
  FILE
  WORKSPACE_PACKAGE
  EXTERNAL_DEPENDENCY
  CONFIG
  OTHER
}

/// Deterministic blast-radius analysis execution and summary for a ChangeRevision.
model BlastRadiusAnalysis {
  id                        String                     @id @default(uuid())
  organizationId            String                     @map("organization_id")
  changeSetId               String                     @map("change_set_id")
  changeRevisionId          String                     @map("change_revision_id")
  baseDigitalTwinSnapshotId String?                    @map("base_digital_twin_snapshot_id")
  headDigitalTwinSnapshotId String?                    @map("head_digital_twin_snapshot_id")
  status                    BlastRadiusAnalysisStatus  @default(QUEUED)
  analysisVersion           String                     @default("blast-radius-v1") @map("analysis_version")
  maxDepth                  Int                        @default(5) @map("max_depth")
  rootCount                 Int                        @default(0) @map("root_count")
  affectedNodeCount         Int                        @default(0) @map("affected_node_count")
  firstOrderCount           Int                        @default(0) @map("first_order_count")
  transitiveCount           Int                        @default(0) @map("transitive_count")
  evidencePathCount         Int                        @default(0) @map("evidence_path_count")
  truncated                 Boolean                    @default(false)
  startedAt                 DateTime?                  @map("started_at")
  completedAt               DateTime?                  @map("completed_at")
  failureCode               String?                    @map("failure_code")
  failureMessage            String?                    @map("failure_message")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changeSet                 ChangeSet                  @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  changeRevision            ChangeRevision             @relation(fields: [changeRevisionId], references: [id], onDelete: Cascade)
  roots                     BlastRadiusRoot[]
  findings                  BlastRadiusFinding[]
  evidencePaths             BlastRadiusEvidencePath[]
  releaseSafetyAssessments  ReleaseSafetyAssessment[]

  @@unique([changeRevisionId, analysisVersion])
  @@index([organizationId])
  @@index([changeSetId])
  @@index([status])
  @@index([createdAt])
  @@map("blast_radius_analyses")
}

/// Deterministic changed entity root triggering blast-radius propagation.
model BlastRadiusRoot {
  id                  String                  @id @default(uuid())
  analysisId          String                  @map("analysis_id")
  twinChangeMappingId String?                 @map("twin_change_mapping_id")
  snapshotSide        BlastRadiusSnapshotSide @map("snapshot_side")
  digitalTwinNodeId   String?                 @map("digital_twin_node_id")
  stableKey           String                  @map("stable_key")
  nodeType            DigitalTwinNodeType     @map("node_type")
  changeKind          ChangedFileStatus       @map("change_kind")
  createdAt           DateTime                @default(now()) @map("created_at")
  analysis            BlastRadiusAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  twinChangeMapping   TwinChangeMapping?      @relation(fields: [twinChangeMappingId], references: [id], onDelete: SetNull)
  digitalTwinNode     DigitalTwinNode?        @relation(fields: [digitalTwinNodeId], references: [id], onDelete: SetNull)
  findings            BlastRadiusFinding[]

  @@index([analysisId])
  @@index([stableKey])
  @@index([digitalTwinNodeId])
  @@map("blast_radius_roots")
}

/// Affected dependent software entity identified through deterministic graph traversal.
model BlastRadiusFinding {
  id                String                  @id @default(uuid())
  analysisId        String                  @map("analysis_id")
  rootId            String?                 @map("root_id")
  digitalTwinNodeId String?                 @map("digital_twin_node_id")
  stableKey         String                  @map("stable_key")
  nodeName          String                  @map("node_name")
  nodePath          String?                 @map("node_path")
  nodeType          DigitalTwinNodeType     @map("node_type")
  category          BlastRadiusCategory
  impactClass       BlastRadiusImpactClass  @map("impact_class")
  depth             Int
  reasonCode        String                  @map("reason_code")
  reasonSummary     String                  @map("reason_summary")
  snapshotSide      BlastRadiusSnapshotSide @map("snapshot_side")
  createdAt         DateTime                @default(now()) @map("created_at")
  analysis          BlastRadiusAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  root              BlastRadiusRoot?        @relation(fields: [rootId], references: [id], onDelete: SetNull)
  digitalTwinNode   DigitalTwinNode?        @relation(fields: [digitalTwinNodeId], references: [id], onDelete: SetNull)
  evidencePaths     BlastRadiusEvidencePath[]

  @@unique([analysisId, stableKey])
  @@index([analysisId])
  @@index([impactClass])
  @@index([category])
  @@index([depth])
  @@map("blast_radius_findings")
}

/// Verifiable, immutable dependency evidence path connecting a root to an affected entity.
model BlastRadiusEvidencePath {
  id                String                  @id @default(uuid())
  analysisId        String                  @map("analysis_id")
  findingId         String                  @map("finding_id")
  rootStableKey     String                  @map("root_stable_key")
  affectedStableKey String                  @map("affected_stable_key")
  snapshotSide      BlastRadiusSnapshotSide @map("snapshot_side")
  depth             Int
  pathNodesJson     Json                    @map("path_nodes_json")
  pathEdgesJson     Json                    @map("path_edges_json")
  createdAt         DateTime                @default(now()) @map("created_at")
  analysis          BlastRadiusAnalysis     @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  finding           BlastRadiusFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([findingId])
  @@index([rootStableKey])
  @@index([affectedStableKey])
  @@map("blast_radius_evidence_paths")
}

/// Release Safety Assessment Status enum.
enum ReleaseSafetyAssessmentStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Release Safety Decision enum.
enum ReleaseSafetyDecision {
  PASS
  REVIEW_REQUIRED
  BLOCKED
}

/// Release Risk Level enum.
enum ReleaseRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Release Safety Signal Severity enum.
enum ReleaseSafetySignalSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Release Safety Signal Category enum derived deterministically from available evidence classes.
enum ReleaseSafetySignalCategory {
  CHANGE_SIZE
  BLAST_RADIUS
  DEPENDENCY
  ARCHITECTURE
  ANALYSIS_QUALITY
}

/// Deterministic, policy-driven Release Safety assessment for a ChangeRevision.
model ReleaseSafetyAssessment {
  id                    String                        @id @default(uuid())
  organizationId        String                        @map("organization_id")
  changeSetId           String                        @map("change_set_id")
  changeRevisionId      String                        @map("change_revision_id")
  blastRadiusAnalysisId String                        @map("blast_radius_analysis_id")
  status                ReleaseSafetyAssessmentStatus @default(QUEUED)
  policyVersion         String                        @default("impactra-release-safety-v1") @map("policy_version")
  riskScore             Int                           @default(0) @map("risk_score")
  riskLevel             ReleaseRiskLevel              @default(LOW) @map("risk_level")
  decision              ReleaseSafetyDecision         @default(PASS)
  signalCount           Int                           @default(0) @map("signal_count")
  blockingSignalCount   Int                           @default(0) @map("blocking_signal_count")
  reviewSignalCount     Int                           @default(0) @map("review_signal_count")
  startedAt             DateTime?                     @map("started_at")
  completedAt           DateTime?                     @map("completed_at")
  failedAt              DateTime?                     @map("failed_at")
  failureCode           String?                       @map("failure_code")
  failureMessage        String?                       @map("failure_message")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changeSet             ChangeSet                     @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  changeRevision        ChangeRevision                @relation(fields: [changeRevisionId], references: [id], onDelete: Cascade)
  blastRadiusAnalysis   BlastRadiusAnalysis           @relation(fields: [blastRadiusAnalysisId], references: [id], onDelete: Cascade)
  signals               ReleaseSafetySignal[]
  gitHubCheckPublications GitHubCheckPublication[]

  @@unique([changeRevisionId, blastRadiusAnalysisId, policyVersion])
  @@index([organizationId])
  @@index([changeSetId])
  @@index([changeRevisionId])
  @@index([blastRadiusAnalysisId])
  @@index([status])
  @@index([decision])
  @@index([createdAt])
  @@map("release_safety_assessments")
}

/// Verifiable, deterministic safety signal contributing to a Release Safety evaluation.
model ReleaseSafetySignal {
  id                  String                      @id @default(uuid())
  organizationId      String                      @map("organization_id")
  assessmentId        String                      @map("assessment_id")
  ruleId              String                      @map("rule_id")
  ruleVersion         String                      @map("rule_version")
  category            ReleaseSafetySignalCategory
  severity            ReleaseSafetySignalSeverity
  scoreDelta          Int                         @map("score_delta")
  blocking            Boolean                     @default(false)
  requiresReview      Boolean                     @default(false) @map("requires_review")
  title               String
  description         String
  evidenceType        String                      @map("evidence_type")
  evidenceReferenceId String?                     @map("evidence_reference_id")
  evidenceStableKey   String?                     @map("evidence_stable_key")
  evidenceJson        Json                        @default("{}") @map("evidence_json")
  createdAt           DateTime                    @default(now()) @map("created_at")
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment          ReleaseSafetyAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assessmentId])
  @@index([ruleId])
  @@index([severity])
  @@index([category])
  @@map("release_safety_signals")
}

/// GitHub Check Publication Status enum.
enum GitHubCheckPublicationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// GitHub Check Conclusion enum mapping authoritative ReleaseSafetyDecision to GitHub Check Wire conclusions.
enum GitHubCheckConclusion {
  SUCCESS
  ACTION_REQUIRED
  FAILURE
}

/// Authoritative publication of an Impactra Release Safety decision to a GitHub commit Check Run.
model GitHubCheckPublication {
  id                        String                       @id @default(uuid())
  organizationId            String                       @map("organization_id")
  repositoryConnectionId    String                       @map("repository_connection_id")
  changeSetId               String                       @map("change_set_id")
  changeRevisionId          String                       @map("change_revision_id")
  releaseSafetyAssessmentId String                       @map("release_safety_assessment_id")
  githubInstallationId      String                       @map("github_installation_id")
  headSha                   String                       @map("head_sha")
  checkName                 String                       @default("Impactra / Release Safety") @map("check_name")
  externalId                String                       @map("external_id")
  githubCheckRunId          String?                      @map("github_check_run_id")
  remoteCheckUrl            String?                      @map("remote_check_url")
  status                    GitHubCheckPublicationStatus @default(QUEUED)
  conclusion                GitHubCheckConclusion?
  detailsUrl                String?                      @map("details_url")
  attemptCount              Int                          @default(0) @map("attempt_count")
  queuedAt                  DateTime                     @default(now()) @map("queued_at")
  startedAt                 DateTime?                    @map("started_at")
  completedAt               DateTime?                    @map("completed_at")
  publishedAt               DateTime?                    @map("published_at")
  failedAt                  DateTime?                    @map("failed_at")
  failureCode               String?                      @map("failure_code")
  failureMessage            String?                      @map("failure_message")
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")
  organization              Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection      RepositoryConnection         @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  changeSet                 ChangeSet                    @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  changeRevision            ChangeRevision               @relation(fields: [changeRevisionId], references: [id], onDelete: Cascade)
  releaseSafetyAssessment   ReleaseSafetyAssessment      @relation(fields: [releaseSafetyAssessmentId], references: [id], onDelete: Cascade)

  @@unique([repositoryConnectionId, headSha, checkName])
  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@index([changeSetId])
  @@index([changeRevisionId])
  @@index([releaseSafetyAssessmentId])
  @@index([status])
  @@index([headSha])
  @@index([externalId])
  @@index([githubCheckRunId])
  @@index([createdAt])
  @@map("github_check_publications")
}
