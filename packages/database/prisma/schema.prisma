datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Foundational SystemMetadata model.
/// Provides schema verification, migrations foundation, and health checks
/// without inventing artificial or premature business domain models.
model SystemMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_metadata")
}

/// Role-Based Access Control (RBAC) roles for Impactra organizations.
enum MembershipRole {
  OWNER
  ADMIN
  ARCHITECT
  SECURITY_ENGINEER
  DEVELOPER
  RELEASE_MANAGER
  QA_ENGINEER
  AUDITOR
  VIEWER
}

/// Core User entity.
model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  name                    String
  passwordHash            String                   @map("password_hash")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  memberships             OrganizationMembership[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         OrganizationInvitation[]   @relation("InvitedByUser")
  githubInstallationStates GitHubInstallationState[]
  repositoryIngestions    RepositoryIngestion[]

  @@map("users")
}

/// Organization tenant boundary for multi-tenancy.
model Organization {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  memberships             OrganizationMembership[]
  invitations             OrganizationInvitation[]
  githubInstallations     GitHubInstallation[]
  githubInstallationStates GitHubInstallationState[]
  repositoryConnections   RepositoryConnection[]
  repositoryIngestions    RepositoryIngestion[]
  repositorySnapshots     RepositorySnapshot[]
  digitalTwinSnapshots    DigitalTwinSnapshot[]

  @@map("organizations")
}

/// Organization membership linking users to organizations with assigned roles.
model OrganizationMembership {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(DEVELOPER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

/// Durable, server-managed user sessions.
/// Stores only the cryptographically secure SHA-256 hash of the session token.
model Session {
  id               String    @id @default(uuid())
  sessionTokenHash String    @unique @map("session_token_hash")
  userId           String    @map("user_id")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Password reset tokens for secure credential recovery.
/// Stores only the SHA-256 hash of the reset token with single-use flag.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Email verification tokens.
/// Stores only the SHA-256 hash of the verification token.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Invitations for joining an organization.
/// Stores hashed invitation token with expiration and role.
model OrganizationInvitation {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  email          String
  role           MembershipRole @default(DEVELOPER)
  tokenHash      String         @unique @map("token_hash")
  inviterId      String         @map("inviter_id")
  expiresAt      DateTime       @map("expires_at")
  acceptedAt     DateTime?      @map("accepted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User           @relation("InvitedByUser", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

/// GitHub Installation Status enum.
enum GitHubInstallationStatus {
  ACTIVE
  SUSPENDED
  DELETED
  DISCONNECTED
}

/// GitHub App installation bound to an Impactra organization.
model GitHubInstallation {
  id                   String                   @id @default(uuid())
  organizationId       String                   @map("organization_id")
  githubInstallationId String                   @unique @map("github_installation_id")
  accountId            String                   @map("account_id")
  accountLogin         String                   @map("account_login")
  accountType          String                   @map("account_type")
  repositorySelection  String                   @map("repository_selection")
  permissions          Json                     @map("permissions")
  events               Json                     @map("events")
  status               GitHubInstallationStatus @default(ACTIVE)
  installedAt          DateTime                 @default(now()) @map("installed_at")
  suspendedAt          DateTime?                @map("suspended_at")
  lastSyncedAt         DateTime?                @map("last_synced_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositories         RepositoryConnection[]

  @@index([organizationId])
  @@index([status])
  @@map("github_installations")
}

/// Ephemeral CSRF installation state binding user and organization.
model GitHubInstallationState {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  stateHash      String       @unique @map("state_hash")
  expiresAt      DateTime     @map("expires_at")
  consumedAt     DateTime?    @map("consumed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([expiresAt])
  @@map("github_installation_states")
}

/// Repository connection metadata tracked by Impactra.
model RepositoryConnection {
  id                   String              @id @default(uuid())
  organizationId       String              @map("organization_id")
  githubInstallationId String              @map("github_installation_id")
  githubRepositoryId   String              @map("github_repository_id")
  ownerLogin           String              @map("owner_login")
  name                 String
  fullName             String              @map("full_name")
  defaultBranch        String              @default("main") @map("default_branch")
  isPrivate            Boolean             @default(false) @map("is_private")
  visibility           String              @default("public")
  archived             Boolean             @default(false)
  disabled             Boolean             @default(false)
  fork                 Boolean             @default(false)
  htmlUrl              String?             @map("html_url")
  available            Boolean             @default(true)
  connected            Boolean             @default(false)
  connectedAt          DateTime?           @map("connected_at")
  disconnectedAt       DateTime?           @map("disconnected_at")
  lastSyncedAt         DateTime?           @map("last_synced_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation         GitHubInstallation  @relation(fields: [githubInstallationId], references: [githubInstallationId], onDelete: Cascade)
  ingestions           RepositoryIngestion[]
  snapshots            RepositorySnapshot[]
  digitalTwins         DigitalTwinSnapshot[]

  @@unique([organizationId, githubRepositoryId])
  @@index([organizationId])
  @@index([githubInstallationId])
  @@index([connected])
  @@index([available])
  @@map("repository_connections")
}

/// Idempotent webhook delivery log for GitHub events.
model GitHubWebhookDelivery {
  id                   String    @id @default(uuid())
  githubDeliveryId     String    @unique @map("github_delivery_id")
  event                String
  action               String?
  githubInstallationId String?   @map("github_installation_id")
  organizationId       String?   @map("organization_id")
  payloadSha256        String    @map("payload_sha256")
  status               String    @default("processed")
  receivedAt           DateTime  @default(now()) @map("received_at")
  processedAt          DateTime? @map("processed_at")
  failureCode          String?   @map("failure_code")
  attemptCount         Int       @default(1) @map("attempt_count")

  @@index([event])
  @@index([githubInstallationId])
  @@index([organizationId])
  @@index([receivedAt])
  @@map("github_webhook_deliveries")
}

/// Repository Ingestion Status enum.
enum RepositoryIngestionStatus {
  QUEUED
  FETCHING
  VALIDATING
  INDEXING
  BUILDING_TWIN
  STORING
  SUCCEEDED
  FAILED
}

/// Digital Twin Node Type enum.
enum DigitalTwinNodeType {
  REPOSITORY
  FILE
  WORKSPACE_PACKAGE
  EXTERNAL_DEPENDENCY
  CONFIG
}

/// Digital Twin Edge Type enum.
enum DigitalTwinEdgeType {
  CONTAINS
  IMPORTS
  DECLARES_DEPENDENCY
  WORKSPACE_DEPENDS_ON
}

/// Repository File Category enum.
enum RepositoryFileCategory {
  SOURCE_CODE
  CONFIGURATION
  DOCUMENTATION
  TEST
  BUILD_SYSTEM
  DATA
  BINARY
  OTHER
}

/// Tracked ingestion job for a repository connection.
model RepositoryIngestion {
  id                     String                    @id @default(uuid())
  organizationId         String                    @map("organization_id")
  repositoryConnectionId String                    @map("repository_connection_id")
  requestedByUserId      String?                   @map("requested_by_user_id")
  targetRef              String                    @default("main") @map("target_ref")
  commitSha              String?                   @map("commit_sha")
  status                 RepositoryIngestionStatus @default(QUEUED)
  stage                  String                    @default("QUEUED")
  startedAt              DateTime?                 @map("started_at")
  completedAt            DateTime?                 @map("completed_at")
  failureCode            String?                   @map("failure_code")
  failureMessage         String?                   @map("failure_message")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection      @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  requestedByUser        User?                     @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  snapshots              RepositorySnapshot[]

  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@index([status])
  @@index([createdAt])
  @@map("repository_ingestions")
}

/// Immutable snapshot representing a repository's source code at a specific commit.
model RepositorySnapshot {
  id                     String                    @id @default(uuid())
  organizationId         String                    @map("organization_id")
  repositoryConnectionId String                    @map("repository_connection_id")
  ingestionId            String                    @map("ingestion_id")
  commitSha              String                    @map("commit_sha")
  ref                    String
  sourceProvider         String                    @default("github") @map("source_provider")
  parserVersion          String                    @default("digital-twin-parser-v1") @map("parser_version")
  artifactKey            String?                   @map("artifact_key")
  artifactSha256         String?                   @map("artifact_sha256")
  sourceBytes            Int                       @default(0) @map("source_bytes")
  fileCount              Int                       @default(0) @map("file_count")
  createdAt              DateTime                  @default(now()) @map("created_at")
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection      @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  ingestion              RepositoryIngestion       @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  fileInventories        RepositoryFileInventory[]
  digitalTwins           DigitalTwinSnapshot[]

  @@unique([repositoryConnectionId, commitSha, parserVersion])
  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@index([commitSha])
  @@map("repository_snapshots")
}

/// Detailed file metadata extracted during snapshot indexing.
model RepositoryFileInventory {
  id                   String                 @id @default(uuid())
  repositorySnapshotId String                 @map("repository_snapshot_id")
  path                 String
  contentSha256        String                 @map("content_sha256")
  byteSize             Int                    @map("byte_size")
  language             String?
  isBinary             Boolean                @default(false) @map("is_binary")
  category             RepositoryFileCategory @default(SOURCE_CODE)
  createdAt            DateTime               @default(now()) @map("created_at")
  snapshot             RepositorySnapshot     @relation(fields: [repositorySnapshotId], references: [id], onDelete: Cascade)

  @@unique([repositorySnapshotId, path])
  @@index([repositorySnapshotId])
  @@index([language])
  @@index([category])
  @@map("repository_file_inventories")
}

/// Architectural digital twin graph generated for a repository snapshot.
model DigitalTwinSnapshot {
  id                     String                 @id @default(uuid())
  organizationId         String                 @map("organization_id")
  repositoryConnectionId String                 @map("repository_connection_id")
  repositorySnapshotId   String                 @unique @map("repository_snapshot_id")
  twinVersion            String                 @default("digital-twin-v1") @map("twin_version")
  nodeCount              Int                    @default(0) @map("node_count")
  edgeCount              Int                    @default(0) @map("edge_count")
  createdAt              DateTime               @default(now()) @map("created_at")
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryConnection   RepositoryConnection   @relation(fields: [repositoryConnectionId], references: [id], onDelete: Cascade)
  repositorySnapshot     RepositorySnapshot     @relation(fields: [repositorySnapshotId], references: [id], onDelete: Cascade)
  nodes                  DigitalTwinNode[]
  edges                  DigitalTwinEdge[]

  @@index([organizationId])
  @@index([repositoryConnectionId])
  @@map("digital_twin_snapshots")
}

/// Graph vertex representing a software entity within the Digital Twin.
model DigitalTwinNode {
  id                    String              @id @default(uuid())
  digitalTwinSnapshotId String              @map("digital_twin_snapshot_id")
  stableKey             String              @map("stable_key")
  type                  DigitalTwinNodeType
  name                  String
  path                  String?
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at")
  snapshot              DigitalTwinSnapshot @relation(fields: [digitalTwinSnapshotId], references: [id], onDelete: Cascade)
  outgoingEdges         DigitalTwinEdge[]   @relation("SourceNode")
  incomingEdges         DigitalTwinEdge[]   @relation("TargetNode")

  @@unique([digitalTwinSnapshotId, stableKey])
  @@index([digitalTwinSnapshotId])
  @@index([type])
  @@index([stableKey])
  @@map("digital_twin_nodes")
}

/// Graph directed edge representing an architectural dependency or relationship.
model DigitalTwinEdge {
  id                    String              @id @default(uuid())
  digitalTwinSnapshotId String              @map("digital_twin_snapshot_id")
  sourceNodeId          String              @map("source_node_id")
  targetNodeId          String              @map("target_node_id")
  type                  DigitalTwinEdgeType
  evidence              Json                @default("{}")
  createdAt             DateTime            @default(now()) @map("created_at")
  snapshot              DigitalTwinSnapshot @relation(fields: [digitalTwinSnapshotId], references: [id], onDelete: Cascade)
  sourceNode            DigitalTwinNode     @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode            DigitalTwinNode     @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([digitalTwinSnapshotId, sourceNodeId, targetNodeId, type])
  @@index([digitalTwinSnapshotId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([type])
  @@map("digital_twin_edges")
}
